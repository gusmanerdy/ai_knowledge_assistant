# Copy this file to .env and replace the placeholder with your OpenRouter key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-3.8-flash

# Local model served by Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-3b-instruct-q6k
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# Authentication and development accounts. Replace every value before deployment.
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-admin-password
ADMIN_DISPLAY_NAME=Administrator
RESEARCHER_USERNAME=researcher
RESEARCHER_PASSWORD=replace-researcher-password
RESEARCHER_DISPLAY_NAME=Researcher
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=replace-viewer-password
VIEWER_DISPLAY_NAME=Viewer
